# scripts/dev-env.ps1.example — 环境变量模板
#
# 拷贝为 dev-env.ps1 并填入真实值后，scripts/start.ps1 会自动 dot-source 加载。
#
#   copy scripts\dev-env.ps1.example scripts\dev-env.ps1
#   notepad scripts\dev-env.ps1

# ====================================================================
# LLM 配置（必填）
# ====================================================================

# 必填：你的 LLM API key
# OpenAI:    sk-...
# DeepSeek:  sk-...
# Ollama:    ollama（本地 ollama 服务，免费）
$env:ORCHA_LLM_API_KEY = "YOUR_LLM_API_KEY_HERE"

# 可选：覆盖默认（base_url = https://api.openai.com/v1，model = gpt-4o）
# $env:ORCHA_LLM_BASE_URL = "https://api.deepseek.com/v1"
# $env:ORCHA_LLM_MODEL = "deepseek-chat"

# 本地 Ollama 示例：
# $env:ORCHA_LLM_BASE_URL = "http://localhost:11434/v1"
# $env:ORCHA_LLM_MODEL = "llama3"

# ====================================================================
# 飞书凭证（接真实飞书时必填，mock 模式可留空）
# ====================================================================
# 飞书开放平台 → 应用详情 → 凭证与基础信息
# $env:ORCHA_FEISHU_APP_ID = "cli_xxx"
# $env:ORCHA_FEISHU_APP_SECRET = "..."
#
# 飞书开放平台 → 事件订阅 → 加密策略
# $env:ORCHA_FEISHU_VERIFICATION_TOKEN = "..."   # Verification Token
# $env:ORCHA_FEISHU_ENCRYPT_KEY = "..."          # Encrypt Key（事件签名校验）
#
# 启动真实飞书模式（默认是 mock=1）
# $env:ORCHA_ADAPTER_MOCK = "0"
